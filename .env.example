# Opcional, mas recomendado para respostas com IA real.
# Sem esta chave, o CalLivora usa respostas locais e modelos prontos.
OPENAI_API_KEY=

# Modelo sugerido. Pode trocar conforme sua conta/disponibilidade.
OPENAI_MODEL=gpt-5-mini

# Porta usada pela interface web/API/MCP HTTP.
PORT=3000

# Nome público do produto exibido na interface.
APP_NAME=CalLivora
